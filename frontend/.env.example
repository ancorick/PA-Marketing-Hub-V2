# Marketing Hub frontend. Copy to .env.local for local work; on Netlify set it in Site settings → Environment variables.
# Base URL of the backend API (no trailing slash). Local backend or the Render service, e.g. https://marketing-hub-api.onrender.com
VITE_API_URL=http://localhost:4000
# Page of the Academy website with the public sign-up form (posts to /api/public/signup); shown in the top bar.
VITE_PUBLIC_SIGNUP_URL=
# "true" shows development aids such as the Dev inbox in a demo deploy. Never set it in production.
VITE_DEMO_MODE=
