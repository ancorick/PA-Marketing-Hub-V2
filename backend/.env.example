# Marketing Hub backend. Copy to .env for local work; on Render set these in the dashboard.
# Never commit real values (NFR-S3).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origins allowed by CORS, comma-separated, exact match (scheme + host + port).
# Local Vite dev server and the Netlify site, e.g. https://marketing-hub.netlify.app
CORS_ORIGINS=http://localhost:5173

# Neon Postgres connection string (Frankfurt region). Empty: an in-process Postgres (PGlite) is used, data is lost on restart.
# Example: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/marketing_hub?sslmode=require
DATABASE_URL=

# Email sending adapter: "log" writes emails to the server log instead of sending.
# A real ESP adapter is added once the ESP is chosen (PRD 16.3, question 1).
EMAIL_ADAPTER=log

# Mailbox for DMARC aggregate reports (rua=). Empty: dmarc-reports@<sending domain>.
DMARC_REPORT_EMAIL=
# Minutes a passed SPF/DKIM/DMARC check stays valid before a marketing send re-checks DNS (EML-03).
DOMAIN_RECHECK_MINUTES=60

# Academy Core Engine (Project 1), Navigator CRM (Project 2), Alumni Tracker (Project 11).
# "mock" uses in-memory stubs with synthetic data until those projects expose their APIs.
INTEGRATIONS_MODE=mock
# Analytics sources (PRD 9.1): website analytics (GA4), Meta Graph API, Meta Ads, Google Ads, CBA rates.
# Only "mock" exists (deterministic synthetic data). Real clients need the accounts and API keys of
# manual task 3 (GA4 property + service account, Meta app token, Google Ads developer token).
ANALYTICS_SOURCES_MODE=mock
# Accept the fixed staff tokens "mock-<role>" (e.g. mock-admin) while there is no Core Engine sign-in.
# Empty: on in development, OFF in production. Setting it to true on a public deploy lets anyone act as admin.
ALLOW_MOCK_SIGN_IN=

# HMAC key for unsubscribe, preferences and confirmation links (NFR-S5), at least 32 characters.
# Required in production; changing it breaks every link already sent. Generate: openssl rand -base64 48
LINK_SIGNING_SECRET=
# Public pages (frontend, Netlify) and the API that mail clients POST one-click unsubscribes to.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Sender and footer of every email (PRD 7.1, EML-11, NFR-P3).
MAIL_FROM=Picsart Academy <news@news.academy-domain.invalid>
ACADEMY_POSTAL_ADDRESS=Picsart Academy, address to be confirmed, Yerevan, Armenia

# Sending pace (EML-09): under the ESP per-second limit; batch size per step.
SEND_RATE_PER_SECOND=14
SEND_BATCH_SIZE=100
# Seed list for test sends (EML-13), comma-separated staff inboxes on different mail clients.
SEED_LIST=
# Scheduled jobs (sync, sends). Empty: on, except in tests.
JOBS_ENABLED=

# ESP webhook signature secret (EML-04, NFR-S4), at least 32 characters. Required in production, or the
# webhook endpoint answers 503. The real ESP adapter may verify with the provider scheme instead.
ESP_WEBHOOK_SECRET=

# Sending IPs or IPv4 CIDR ranges allowed to send for the domain (ESP ranges), comma-separated (EML-07).
# DMARC failures from other IPs alert the admin as unknown sources.
DMARC_KNOWN_SOURCES=

# Admissions page the newsletter call to action links to. Empty: no button in that block.
ADMISSIONS_URL=

# NWS-04: "draft ready" notices. Slack incoming webhook URL (secret) and newsletter editors, comma-separated.
SLACK_WEBHOOK_URL=
NEWSLETTER_EDITOR_EMAILS=
# Comma-separated admin addresses for data source failures (a source failing twice in a row, ANL-11).
# The same alert also goes to SLACK_WEBHOOK_URL.
ADMIN_ALERT_EMAILS=

# NWS-07 AI writing assist (Claude API). Empty: the feature is off; nothing else depends on it.
# Only public facts from collected newsletter items are sent (no contact data).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
