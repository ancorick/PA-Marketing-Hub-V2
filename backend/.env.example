# Marketing Hub backend. Copy to .env for local work; on Render set these in the dashboard.
# Never commit real values (NFR-S3).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Frontend origins allowed by CORS, comma-separated, exact match (scheme + host + port).
# Local Vite dev server and the Netlify site, e.g. https://marketing-hub.netlify.app
CORS_ORIGINS=http://localhost:5173

# Neon Postgres connection string (Frankfurt region). Leave empty to run without a database.
# Example: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/marketing_hub?sslmode=require
DATABASE_URL=

# Email sending adapter: "log" writes emails to the server log instead of sending.
# A real ESP adapter is added once the ESP is chosen (PRD 16.3, question 1).
EMAIL_ADAPTER=log

# Mailbox for DMARC aggregate reports (rua=). Empty: dmarc-reports@<sending domain>.
DMARC_REPORT_EMAIL=
# Minutes a passed SPF/DKIM/DMARC check stays valid before a marketing send re-checks DNS (EML-03).
DOMAIN_RECHECK_MINUTES=60

# Academy Core Engine (Project 1), Navigator CRM (Project 2), Alumni Tracker (Project 11).
# "mock" uses in-memory stubs with synthetic data until those projects expose their APIs.
INTEGRATIONS_MODE=mock
